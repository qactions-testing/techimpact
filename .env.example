# ── Medición (públicas) ────────────────────────────────────────────────────
# Contenedor de Google Tag Manager (GTM-XXXXXXX). Sin valor, no se carga GTM.
NEXT_PUBLIC_GTM_ID=
# 1 = activa Vercel Web Analytics (requiere plan Pro para uso comercial).
NEXT_PUBLIC_VERCEL_ANALYTICS=
# hCaptcha (partner). Sin valor, el formulario usa honeypot + rate limit.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=

# ── Secretos (solo servidor) ───────────────────────────────────────────────
BREVO_API_KEY=
# Lista "TechImpact · Leads" (npm run brevo:setup la crea e imprime el id).
BREVO_LIST_ID=
# Remitente verificado en Brevo.
BREVO_SENDER_EMAIL=marketing@qactions.com
# Opcional: plantilla de doble opt-in para quienes aceptan novedades.
BREVO_DOI_TEMPLATE_ID=
# Opcional: pipeline y etapa de los deals de demo (Brevo CRM).
BREVO_PIPELINE_ID=
BREVO_DEAL_STAGE_ID=
# Alerta a ventas por cada lead y demo (separar varios con coma).
LEAD_NOTIFY_EMAIL=comercial@qactions.com
# Personal Access Token de Calendly (plan gratis) para verificar reservas.
CALENDLY_TOKEN=
HCAPTCHA_SECRET=
